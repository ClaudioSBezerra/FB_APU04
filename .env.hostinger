# Production Environment Variables
# FB_APU04 - Simulador Fiscal
# Deploy: GitHub → Coolify → AWS
# VERSÃO: 1.0.0

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
PORT=8084
APP_MODULE=simulador
VITE_APP_MODULE=simu
COOKIE_SECURE=true
JWT_SECRET=super-secure-jwt-secret-for-production-change-me-2026

# ========================================
# BANCO DE DADOS (próprio — isolado do APU02)
# ========================================
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_2026
DB_NAME=fiscal_apu04_db
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# ========================================
# REDIS
# ========================================
REDIS_ADDR=redis:6379

# ========================================
# SMTP (HOSTINGER)
# ========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@fortesbezerra.com.br
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=FBTax Cloud <contato@fortesbezerra.com.br>
APP_URL=https://simu.fbtax.cloud

# ========================================
# Z.AI GLM API
# ========================================
ZAI_API_KEY=your_zai_api_key_here

# ========================================
# SEGURANÇA
# ========================================
CORS_ORIGINS=https://simu.fbtax.cloud,https://simu.fcxlabs.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
SESSION_TIMEOUT=24h
AUDIT_LOGS=true

# ========================================
# DESENVOLVIMENTO (COMENTAR EM PRODUÇÃO)
# ========================================
# DEBUG=false
# VERBOSE_LOGS=false
# HOT_RELOAD=false
