# FB_APU04 - DOCKERFILE PARA PRODUÇÃO (COOLIFY)
# FB_APU04 Fiscal Engine — produto oficial
# Fluxo: GitHub → Coolify

# Build stage
FROM node:18-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Backend stage
FROM golang:1.24-alpine AS backend-builder
WORKDIR /app/backend

RUN apk add --no-cache git

# Deps primeiro (camada cacheável): go.mod/go.sum + vendor versionado.
# Código vem depois → mudar fonte NÃO invalida a camada de deps.
# -mod=vendor usa o vendor/ do repo → build offline, sem `go mod download`
# pela rede a cada build (era a causa do build lento no Coolify).
COPY backend/go.mod backend/go.sum ./
COPY backend/vendor ./vendor

COPY backend/ ./

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -ldflags="-w -s" \
    -o fb_apu04-api main.go

# Production stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates curl tzdata postgresql-client

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

RUN ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime

WORKDIR /app

COPY --from=backend-builder /app/backend/fb_apu04-api .
COPY --from=frontend-builder /app/frontend/dist ./static
COPY backend/migrations ./migrations

RUN mkdir -p /app/uploads /app/logs /app/backups && \
    chown -R appuser:appgroup /app

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8084/api/health || exit 1

EXPOSE 8084

CMD ["./fb_apu04-api"]

LABEL maintainer="FB_APU04 Team"
LABEL description="FB_APU04 Fiscal Engine"
LABEL com.coolify.image=true
